# ---------------------------------------------------------------------------
# TeacherCopilot - backend environment configuration
# Copy this file to `.env` and fill in your values.
# ---------------------------------------------------------------------------

# --- LLM provider (any OpenAI-compatible endpoint) -------------------------
# DeepSeek: https://platform.deepseek.com  ->  create an API key
# Leave LLM_API_KEY EMPTY (or set MOCK_LLM=true) to run fully offline with
# realistic canned responses -- the whole app is demoable without a key.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Force mock mode even when an API key is present (great for demos/tests)
MOCK_LLM=false

# Request tuning
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3          # network-level retries
LLM_JSON_REPAIR_RETRIES=2 # schema-repair retries inside llm.py

# --- App -------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database --------------------------------------------------------------
DATABASE_URL=sqlite:///./teachercopilot.db

# --- Outbound messaging (all optional; simulated by default) ---------------
# Messaging stays SIMULATED unless you explicitly configure a provider here.
MESSAGING_MODE=simulated      # simulated | smtp | twilio

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=teacher@school.edu
SMTP_USE_TLS=true

# WhatsApp / Twilio-style (optional)
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM=whatsapp:+14155238886

# Seed demo teacher account
SEED_DEMO=true
DEMO_TEACHER_EMAIL=demo@teachercopilot.app
DEMO_TEACHER_PASSWORD=demo1234
